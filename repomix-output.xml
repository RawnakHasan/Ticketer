// What a template needs to draw one ticket. Built from the settings by buildTicketState.
export type TicketState = {
  tpl: TemplateId;
  main: Photo | null;
  stub: Photo | null;
  f: Record<FieldKey, string>;
  show: Record<string, boolean>;
  st: Stock;
  acc: RGB;
  // The CSS filter applied to photos
