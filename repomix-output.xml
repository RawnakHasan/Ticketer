<file path="src/components/ticket/PhotoCrop.tsx">
import { useEffect, useRef, type KeyboardEvent, type PointerEvent } from "react";

import { clamp } from "@/lib/ticket/math";
import { drawCover, panRange } from "@/lib/ticket/photo";
import type { Photo } from "@/lib/ticket/types";

type PhotoCropProps = {
  photo: Photo;
  // Width over height of the frame the photo is cropped to
  ratio: number;
  filter: string;
  label: string;
  onChange: (patch: Partial<Photo>) => void;
};

// A canvas showing exactly what the ticket will show. Drag to pan, arrow keys to nudge, + and - to zoom.
export function PhotoCrop({ photo, ratio, filter, label, onChange }: PhotoCropProps) {
  const ref = useRef<HTMLCanvasElement>(null);
  const drag = useRef<{ px: number; py: number; x: number; y: number } | null>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const width = Math.max(300, canvas.clientWidth * 2);
    canvas.width = width;
    canvas.height = Math.round(width / ratio);
    drawCover(canvas.getContext("2d")!, photo, 0, 0, canvas.width, canvas.height, 0, filter);
  }, [photo, ratio, filter]);

  function handleMove(event: PointerEvent<HTMLCanvasElement>) {
    const start = drag.current;
    const canvas = ref.current;
    if (!start || !canvas) return;

    const [rangeX, rangeY] = panRange(photo, canvas.clientWidth, canvas.clientWidth / ratio);
    onChange({
      x: clamp(start.x - (event.clientX - start.px) / (Math.abs(rangeX) < 1 ? 1 : rangeX)),
      y: clamp(start.y - (event.clientY - start.py) / (Math.abs(rangeY) < 1 ? 1 : rangeY)),
    });
  }

  function handleKeyDown(event: KeyboardEvent<HTMLCanvasElement>) {
    const changes: Record<string, Partial<Photo>> = {
      ArrowLeft: { x: clamp(photo.x + 0.1) },
      ArrowRight: { x: clamp(photo.x - 0.1) },
      ArrowUp: { y: clamp(photo.y + 0.1) },
      ArrowDown: { y: clamp(photo.y - 0.1) },
      "+": { z: Math.min(3, photo.z + 0.1) },
      "-": { z: Math.max(0.4, photo.z - 0.1) },
    };
    const change = changes[event.key];
    if (change) {
      event.preventDefault();
      onChange(change);
    }
  }

  return (
    <canvas
      ref={ref}
      tabIndex={0}
      role="application"
      aria-label={`${label} crop. Drag or use arrow keys to move, plus and minus to zoom.`}
      style={{ aspectRatio: ratio }}
      className="w-full cursor-grab touch-none rounded-xl bg-surface-container-highest outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-secondary active:cursor-grabbing"
      onKeyDown={handleKeyDown}
      onPointerDown={(event) => {
        event.currentTarget.setPointerCapture(event.pointerId);
        drag.current = { px: event.clientX, py: event.clientY, x: photo.x, y: photo.y };
      }}
      onPointerMove={handleMove}
      onPointerUp={() => {
        drag.current = null;
      }}
    />
  );
}
</file>

<file path="src/components/ticket/PhotoSlot.tsx">
import { ImagePlus } from "lucide-react";
import { useRef, useState } from "react";

import { Button } from "@/components/ui/Button";
import { Section, SliderField } from "@/components/ticket/controls";
import { PhotoCrop } from "@/components/ticket/PhotoCrop";
import { cn } from "@/lib/utils";
import { smartCrop, shownAspect } from "@/lib/ticket/photo";
import type { PhotoSlot as Slot } from "@/lib/ticket/types";
import { usePhotoStore } from "@/stores/photoStore";

type PhotoSlotProps = {
  slot: Slot;
  label: string;
  // Width over height of the frame this photo fills on the ticket
  ratio: number;
  filter: string;
  hint?: string;
  // The photo is too small for the export size and will look soft
  lowRes?: boolean;
};

export function PhotoSlot({ slot, label, ratio, filter, hint, lowRes }: PhotoSlotProps) {
  const photo = usePhotoStore((s) => s[slot]);
  const add = usePhotoStore((s) => s.add);
  const patch = usePhotoStore((s) => s.patch);
  const clear = usePhotoStore((s) => s.clear);
  const inputRef = useRef<HTMLInputElement>(null);
  const [dragging, setDragging] = useState(false);

  // One picker for both states: inside the drop zone when empty, and for "Replace" once a photo is set
  const fileInput = (
    <input
      ref={inputRef}
      type="file"
      accept="image/*"
      className="sr-only"
      onChange={(event) => {
        const file = event.target.files?.[0];
        if (file) void add(slot, file);
        event.target.value = "";
      }}
    />
  );

  return (
    <Section
      title={label}
      action={
        photo && (
          <Button variant="text" size="xs" onClick={() => clear(slot)}>
            Remove
          </Button>
        )
      }
    >
      {photo ? (
        <>
          <PhotoCrop
            photo={photo}
            ratio={ratio}
            filter={filter}
            label={label}
            onChange={(change) => patch(slot, change)}
          />
          <SliderField
            label="Zoom"
            value={photo.z}
            min={0.4}
            max={3}
            step={0.05}
            format={(v) => `${v.toFixed(2)}×`}
            onChange={(z) => patch(slot, { z })}
          />
          <div className="flex flex-wrap gap-2">
            <Button variant="tonal" size="xs" onClick={() => patch(slot, { rot: photo.rot + 1 })}>
              Rotate 90°
            </Button>
            <Button variant="tonal" size="xs" onClick={() => patch(slot, smartCrop(photo))}>
              Smart crop
            </Button>
            <Button
              variant="tonal"
              size="xs"
              onClick={() => {
                const a = shownAspect(photo);
                patch(slot, { z: Math.min(ratio / a, a / ratio), x: 0, y: 0 });
              }}
            >
              Fit whole photo
            </Button>
            <Button variant="tonal" size="xs" onClick={() => inputRef.current?.click()}>
              Replace
            </Button>
          </div>
          {lowRes && (
            <p
              role="status"
              className="rounded-xl bg-secondary-container px-4 py-3 text-sm text-on-secondary-container"
            >
              Low resolution for this export size. It may look soft; pick a bigger photo or a
              smaller size.
            </p>
          )}
        </>
      ) : (
        <label
          onDragOver={(event) => {
            event.preventDefault();
            setDragging(true);
          }}
          onDragLeave={() => setDragging(false)}
          onDrop={(event) => {
            event.preventDefault();
            setDragging(false);
            const file = event.dataTransfer.files[0];
            if (file) void add(slot, file);
          }}
          className={cn(
            "grid min-h-36 cursor-pointer place-items-center gap-1 rounded-xl border-2 border-dashed p-6 text-center text-on-surface-variant transition-colors",
            "has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-secondary",
            dragging
              ? "border-primary bg-primary/10"
              : "border-outline-variant hover:bg-on-surface/8",
          )}
        >
          <ImagePlus aria-hidden="true" className="size-8" />
          <span className="text-base font-medium text-on-surface">Tap or drop a photo</span>
          <span className="text-sm">JPG, PNG, WebP or HEIC{hint ? ` · ${hint}` : ""}</span>
          {/* Inside the label, so a click or tap on the zone opens the picker and focus shows on it */}
          {fileInput}
        </label>
      )}

      {photo ? fileInput : null}
    </Section>
  );
}
</file>

