// Rounded polygons, following the corner math of androidx.graphics.shapes (the library behind
// Material's shapes on Android). A shape is a closed list of cubic Béziers.

export type Point = { x: number; y: number };

// radius is in the shape's own units, smoothing (0..1) extends the corner with a gentler curve
export type CornerRounding = { readonly radius: number; readonly smoothing: number };

// x0 y0, x1 y1, x2 y2, x3 y3
export type Cubic = [number, number, number, number, number, number, number, number];

export type RoundedPolygon = { cubics: Cubic[]; centerX: number; centerY: number };

// A template vertex for customPolygon: x, y and an optional rounding
export type Vertex = [x: number, y: number, rounding?: CornerRounding];

export const UNROUNDED: CornerRounding = { radius: 0, smoothing: 0 };
export const rounding = (radius: number, smoothing = 0): CornerRounding => ({ radius, smoothing });

const EPSILON = 1e-4;

const direction = (x: number, y: number): Point => {
  const d = Math.hypot(x, y);
  return d > 0 ? { x: x / d, y: y / d } : { x: 0, y: 0 };
};
const rotate90 = (p: Point): Point => ({ x: -p.y, y: p.x });
const dot = (a: Point, b: Point) => a.x * b.x + a.y * b.y;

function straightLine(x0: number, y0: number, x1: number, y1: number): Cubic {
  return [
    x0,
    y0,
    x0 + (x1 - x0) / 3,
    y0 + (y1 - y0) / 3,
    x0 + ((x1 - x0) * 2) / 3,
    y0 + ((y1 - y0) * 2) / 3,
    x1,
    y1,
  ];
}

function circularArc(center: Point, p0: Point, p1: Point): Cubic {
  const p0d = direction(p0.x - center.x, p0.y - center.y);
  const p1d = direction(p1.x - center.x, p1.y - center.y);
  const rotatedP0 = rotate90(p0d);
  const rotatedP1 = rotate90(p1d);
  const clockwise = dot(rotatedP0, { x: p1.x - center.x, y: p1.y - center.y }) >= 0;
  const cosa = dot(p0d, p1d);
  if (cosa > 0.999) return straightLine(p0.x, p0.y, p1.x, p1.y);
  const k =
    ((Math.hypot(p0.x - center.x, p0.y - center.y) * 4) / 3) *
    ((Math.sqrt(2 * (1 - cosa)) - Math.sqrt(1 - cosa * cosa)) / (1 - cosa)) *
    (clockwise ? 1 : -1);
  return [
    p0.x,
    p0.y,
    p0.x + rotatedP0.x * k,
    p0.y + rotatedP0.y * k,
    p1.x - rotatedP1.x * k,
    p1.y - rotatedP1.y * k,
    p1.x,
    p1.y,
  ];
}

function lineIntersection(p0: Point, d0: Point, p1: Point, d1: Point): Point | null {
  const rotatedD1 = rotate90(d1);
  const den = dot(d0, rotatedD1);
  if (Math.abs(den) < EPSILON) return null;
  const num = dot({ x: p1.x - p0.x, y: p1.y - p0.y }, rotatedD1);
  if (Math.abs(den) < EPSILON * Math.abs(num)) return null;
  const k = num / den;
  return { x: p0.x + d0.x * k, y: p0.y + d0.y * k };
}

// The curve that leads from the straight side into the circular arc of a corner
function flankingCurve(
  actualRoundCut: number,
  actualSmoothing: number,
  corner: Point,
  sideStart: Point,
  circleSegmentIntersection: Point,
  otherCircleSegmentIntersection: Point,
  circleCenter: Point,
  actualR: number,
): Cubic {
  const sideDirection = direction(sideStart.x - corner.x, sideStart.y - corner.y);
  const curveStart: Point = {
    x: corner.x + sideDirection.x * actualRoundCut * (1 + actualSmoothing),
    y: corner.y + sideDirection.y * actualRoundCut * (1 + actualSmoothing),
  };
  // Approximation of where the arc starts, good enough and cheap
  const mid: Point = {
    x: (circleSegmentIntersection.x + otherCircleSegmentIntersection.x) / 2,
    y: (circleSegmentIntersection.y + otherCircleSegmentIntersection.y) / 2,
  };
  const p: Point = {
    x: circleSegmentIntersection.x + (mid.x - circleSegmentIntersection.x) * actualSmoothing,
    y: circleSegmentIntersection.y + (mid.y - circleSegmentIntersection.y) * actualSmoothing,
  };
  const toP = direction(p.x - circleCenter.x, p.y - circleCenter.y);
  const curveEnd: Point = {
    x: circleCenter.x + toP.x * actualR,
    y: circleCenter.y + toP.y * actualR,
  };
  const circleTangent = rotate90(
    direction(curveEnd.x - circleCenter.x, curveEnd.y - circleCenter.y),
  );
  const anchorEnd =
    lineIntersection(sideStart, sideDirection, curveEnd, circleTangent) ??
    circleSegmentIntersection;
  const anchorStart: Point = {
    x: (curveStart.x + anchorEnd.x * 2) / 3,
    y: (curveStart.y + anchorEnd.y * 2) / 3,
  };
  return [
    curveStart.x,
    curveStart.y,
    anchorStart.x,
    anchorStart.y,
    anchorEnd.x,
    anchorEnd.y,
    curveEnd.x,
    curveEnd.y,
  ];
}

const reverseCubic = (c: Cubic): Cubic => [c[6], c[7], c[4], c[5], c[2], c[3], c[0], c[1]];

function roundedCorner(p0: Point, p1: Point, p2: Point, r: CornerRounding) {
  const d1 = direction(p0.x - p1.x, p0.y - p1.y);
  const d2 = direction(p2.x - p1.x, p2.y - p1.y);
  const cosAngle = dot(d1, d2);
  const sinAngle = Math.sqrt(1 - cosAngle * cosAngle);
  const expectedRoundCut = sinAngle > 1e-3 ? (r.radius * (cosAngle + 1)) / sinAngle : 0;
  const expectedCut = (1 + r.smoothing) * expectedRoundCut;

  const actualSmoothing = (allowedCut: number) => {
    if (allowedCut > expectedCut) return r.smoothing;
    if (allowedCut > expectedRoundCut) {
      return (r.smoothing * (allowedCut - expectedRoundCut)) / (expectedCut - expectedRoundCut);
    }
    return 0;
  };

  function getCubics(allowedCut0: number, allowedCut1: number): Cubic[] {
    const allowedCut = Math.min(allowedCut0, allowedCut1);
    if (expectedRoundCut < EPSILON || allowedCut < EPSILON || r.radius < EPSILON) {
      return [straightLine(p1.x, p1.y, p1.x, p1.y)];
    }
    const actualRoundCut = Math.min(allowedCut, expectedRoundCut);
    const actualR = (r.radius * actualRoundCut) / expectedRoundCut;
    const centerDistance = Math.sqrt(actualR * actualR + actualRoundCut * actualRoundCut);
    const bisector = direction((d1.x + d2.x) / 2, (d1.y + d2.y) / 2);
    const center: Point = {
      x: p1.x + bisector.x * centerDistance,
      y: p1.y + bisector.y * centerDistance,
    };
    const circleIntersection0: Point = {
      x: p1.x + d1.x * actualRoundCut,
      y: p1.y + d1.y * actualRoundCut,
    };
    const circleIntersection2: Point = {
      x: p1.x + d2.x * actualRoundCut,
      y: p1.y + d2.y * actualRoundCut,
    };

    const flanking0 = flankingCurve(
      actualRoundCut,
      actualSmoothing(allowedCut0),
      p1,
      p0,
      circleIntersection0,
      circleIntersection2,
      center,
      actualR,
    );
    const flanking2 = reverseCubic(
      flankingCurve(
        actualRoundCut,
        actualSmoothing(allowedCut1),
        p1,
        p2,
        circleIntersection2,
        circleIntersection0,
        center,
        actualR,
      ),
    );
    const arc = circularArc(
      center,
      { x: flanking0[6], y: flanking0[7] },
      { x: flanking2[0], y: flanking2[1] },
    );
    return [flanking0, arc, flanking2];
  }

  return { expectedRoundCut, expectedCut, getCubics };
}

export function roundedPolygon(
  vertices: Point[],
  roundings: CornerRounding[],
  centerX: number,
  centerY: number,
): RoundedPolygon {
  const n = vertices.length;
  const corners = vertices.map((v, i) =>
    roundedCorner(vertices[(i + n - 1) % n], v, vertices[(i + 1) % n], roundings[i] ?? UNROUNDED),
  );

  // Two neighboring corners can't cut more than the side between them: shrink them if needed
  const cutAdjusts = vertices.map((v, i) => {
    const a = corners[i];
    const b = corners[(i + 1) % n];
    const next = vertices[(i + 1) % n];
    const expectedRoundCut = a.expectedRoundCut + b.expectedRoundCut;
    const expectedCut = a.expectedCut + b.expectedCut;
    const side = Math.hypot(next.x - v.x, next.y - v.y);
    if (expectedRoundCut > side) return [side / expectedRoundCut, 0];
    if (expectedCut > side)
      return [1, (side - expectedRoundCut) / (expectedCut - expectedRoundCut)];
    return [1, 1];
  });

  const cornerCubics = corners.map((c, i) => {
    const allowed = [0, 1].map((delta) => {
      const [roundCutRatio, cutRatio] = cutAdjusts[(i + n - 1 + delta) % n];
      return c.expectedRoundCut * roundCutRatio + (c.expectedCut - c.expectedRoundCut) * cutRatio;
    });
    return c.getCubics(allowed[0], allowed[1]);
  });

  const cubics: Cubic[] = [];
  for (let i = 0; i < n; i++) {
    const own = cornerCubics[i];
    cubics.push(...own);
    const last = own[own.length - 1];
    const nextStart = cornerCubics[(i + 1) % n][0];
    cubics.push(straightLine(last[6], last[7], nextStart[0], nextStart[1]));
  }
  return { cubics, centerX, centerY };
}

function regularVertices(n: number, radius: number, cx: number, cy: number): Point[] {
  return Array.from({ length: n }, (_, i) => {
    const angle = (Math.PI / n) * 2 * i;
    return { x: radius * Math.cos(angle) + cx, y: radius * Math.sin(angle) + cy };
  });
}

export function regularPolygon(
  n: number,
  radius = 1,
  centerX = 0,
  centerY = 0,
  cornerRounding: CornerRounding = UNROUNDED,
  perVertexRounding?: CornerRounding[],
): RoundedPolygon {
  const roundings = perVertexRounding ?? Array.from({ length: n }, () => cornerRounding);
  return roundedPolygon(regularVertices(n, radius, centerX, centerY), roundings, centerX, centerY);
}

export function circle(n = 8, radius = 1, centerX = 0, centerY = 0): RoundedPolygon {
  const polygonRadius = radius / Math.cos(Math.PI / n);
  return regularPolygon(n, polygonRadius, centerX, centerY, rounding(radius));
}

export function star(
  numVerticesPerRadius: number,
  radius: number,
  innerRadius: number,
  cornerRounding: CornerRounding,
  centerX = 0,
  centerY = 0,
): RoundedPolygon {
  const vertices: Point[] = [];
  for (let i = 0; i < numVerticesPerRadius; i++) {
    const outer = (Math.PI / numVerticesPerRadius) * 2 * i;
    const inner = (Math.PI / numVerticesPerRadius) * (2 * i + 1);
    vertices.push({ x: radius * Math.cos(outer) + centerX, y: radius * Math.sin(outer) + centerY });
    vertices.push({
      x: innerRadius * Math.cos(inner) + centerX,
      y: innerRadius * Math.sin(inner) + centerY,
    });
  }
  return roundedPolygon(
    vertices,
    vertices.map(() => cornerRounding),
    centerX,
    centerY,
  );
}

export function rectangle(
  width: number,
  height: number,
  cornerRounding: CornerRounding,
  perVertexRounding?: CornerRounding[],
  centerX = 0,
  centerY = 0,
): RoundedPolygon {
  const left = centerX - width / 2;
  const top = centerY - height / 2;
  const right = centerX + width / 2;
  const bottom = centerY + height / 2;
  const vertices: Point[] = [
    { x: right, y: bottom },
    { x: left, y: bottom },
    { x: left, y: top },
    { x: right, y: top },
  ];
  const roundings = perVertexRounding ?? vertices.map(() => cornerRounding);
  return roundedPolygon(vertices, roundings, centerX, centerY);
}

// Repeats the template around the center, optionally mirroring every other repeat
function repeatAroundCenter(
  template: Vertex[],
  repeat: number,
  cx: number,
  cy: number,
  mirroring: boolean,
) {
  const radial = template.map(([x, y, r]) => ({
    angle: Math.atan2(y - cy, x - cx),
    distance: Math.hypot(x - cx, y - cy),
    r: r ?? UNROUNDED,
  }));
  const out: { angle: number; distance: number; r: CornerRounding }[] = [];
  let span = (2 * Math.PI) / repeat;

  if (mirroring) {
    const count = repeat * 2;
    span /= 2;
    for (let i = 0; i < count; i++) {
      for (let j = 0; j < radial.length; j++) {
        const reverse = i % 2 !== 0;
        const index = reverse ? radial.length - 1 - j : j;
        const point = radial[index];
        if (index > 0 || !reverse) {
          const angle =
            span * i + (reverse ? span - point.angle + 2 * radial[0].angle : point.angle);
          out.push({ angle, distance: point.distance, r: point.r });
        }
      }
    }
  } else {
    for (let i = 0; i < repeat; i++) {
      for (const point of radial) {
        out.push({ angle: span * i + point.angle, distance: point.distance, r: point.r });
      }
    }
  }

  return out.map(({ angle, distance, r }) => ({
    vertex: { x: distance * Math.cos(angle) + cx, y: distance * Math.sin(angle) + cy },
    rounding: r,
  }));
}

export function customPolygon(
  template: Vertex[],
  repeat: number,
  centerX: number,
  centerY: number,
  mirroring: boolean,
): RoundedPolygon {
  const repeated = repeatAroundCenter(template, repeat, centerX, centerY, mirroring);
  return roundedPolygon(
    repeated.map((v) => v.vertex),
    repeated.map((v) => v.rounding),
    centerX,
    centerY,
  );
}

export function transformed(
  polygon: RoundedPolygon,
  fn: (x: number, y: number) => [number, number],
): RoundedPolygon {
  const [centerX, centerY] = fn(polygon.centerX, polygon.centerY);
  const cubics = polygon.cubics.map((c) => {
    const [a, b] = fn(c[0], c[1]);
    const [d, e] = fn(c[2], c[3]);
    const [f, g] = fn(c[4], c[5]);
    const [h, i] = fn(c[6], c[7]);
    return [a, b, d, e, f, g, h, i] as Cubic;
  });
  return { cubics, centerX, centerY };
}

export const rotated = (polygon: RoundedPolygon, degrees: number) => {
  const rad = (degrees * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  return transformed(polygon, (x, y): [number, number] => [x * cos - y * sin, x * sin + y * cos]);
};

export const scaled = (polygon: RoundedPolygon, sx: number, sy: number) =>
  transformed(polygon, (x, y): [number, number] => [x * sx, y * sy]);

// Moves the center to (0, 0) and scales so the farthest point of the shape is at distance 1,
// so it fits in the unit circle and can rotate around its center
export function normalizeRadial(polygon: RoundedPolygon): Cubic[] {
  let maxSquared = 0;
  for (const c of polygon.cubics) {
    const midX = (c[0] + 3 * c[2] + 3 * c[4] + c[6]) / 8;
    const midY = (c[1] + 3 * c[3] + 3 * c[5] + c[7]) / 8;
    maxSquared = Math.max(
      maxSquared,
      (c[0] - polygon.centerX) ** 2 + (c[1] - polygon.centerY) ** 2,
      (midX - polygon.centerX) ** 2 + (midY - polygon.centerY) ** 2,
    );
  }
  const scale = 1 / Math.sqrt(maxSquared);
  return transformed(polygon, (x, y): [number, number] => [
    (x - polygon.centerX) * scale,
    (y - polygon.centerY) * scale,
  ]).cubics;
}
</file>

<file path="src/lib/ticket/render/admit.ts">
import { rgb, rgba } from "../color";
import { drawCover } from "../photo";
import {
  barcode,
  createTicketCanvas,
  drawMainPhoto,
  drawQr,
  FB,
  FC,
  FM,
  makeFit,
  punch,
} from "./shared";
import type { Fit } from "./shared";
import type { Rendered, TicketState } from "./types";

const W = 600;
const BASE_H = 1000;
const NOTCH_Y = 708;
const NOTCH_R = 22;

// The classic tall ticket: photo, title, details grid, tear line and a stub with a barcode.
export function renderAdmit(S: TicketState, k: number): Rendered {
  const { dy, f, show, st } = S;
  const H = BASE_H + dy;
  const warnings: string[] = [];
  const { canvas, c } = createTicketCanvas(S, k, W, H, 28);
  const fit = makeFit(c, warnings);

  const on = (key: string) => Boolean(show[key] && f[key as keyof typeof f]?.trim());
  const ink = rgb(st.ink);
  const muted = rgba(st.ink, 0.74);
  const accent = rgb(st.acc);
  const onAccent = rgb(st.onacc);

  drawMainPhoto(c, S, 16, 16, 568, 372 + dy, 0.3);
  c.textAlign = "left";

  if (on("tier")) {
    const r = fit(f.tier.toUpperCase(), FM(500), 300, 20, 13, 10, 1, "Tier label");
    const w = c.measureText(r.ls[0]).width + 28;
    c.fillStyle = accent;
    c.beginPath();
    c.roundRect(32, 32, w, 30, 15);
    c.fill();
    c.fillStyle = onAccent;
    c.fillText(r.ls[0], 46, 52);
  }

  if (show.stamp) {
    c.save();
    const [sx, sy] = S.sp ? [S.sp.x * W, S.sp.y * H] : [496, 322 + dy];
    c.translate(sx, sy);
    c.scale(S.ssc, S.ssc);
    c.rotate(-0.24);
    c.fillStyle = accent;
    c.beginPath();
    c.arc(0, 0, 50, 0, 7);
    c.fill();
    c.strokeStyle = onAccent;
    c.lineWidth = 2;
    c.setLineDash([3, 4]);
    c.beginPath();
    c.arc(0, 0, 42, 0, 7);
    c.stroke();
    c.setLineDash([]);
    c.fillStyle = onAccent;
    c.textAlign = "center";
    c.font = FB(19);
    c.fillText("ADMIT", 0, -2);
    c.fillText("ONE", 0, 19);
    c.restore();
  }

  // Everything below the photo moves down with the photo's extra height
  c.save();
  c.translate(0, dy);
  c.textAlign = "left";
  let y = 414;

  if (on("title")) {
    c.fillStyle = ink;
    const r = fit(f.title, FB, 528, 100, 60, 28, 1.02, "Title");
    r.ls.forEach((line, i) => c.fillText(line, 36, y + r.s * 0.86 + i * r.s * 1.02));
    y += r.ls.length * r.s * 1.02 + 10;
  }
  if (on("sub")) {
    c.fillStyle = muted;
    const r = fit(f.sub, FM(), 528, 36, 17, 11, 1.25, "Subtitle");
    r.ls.forEach((line, i) => c.fillText(line, 36, y + r.s + i * r.s * 1.25));
  }

  const details = [
    ["name", "ADMIT ONE"],
    ["date", "DATE"],
    ["time", "TIME"],
    ["price", "PRICE"],
    ["place", "VENUE"],
  ].filter(([key]) => on(key));

  details.forEach(([key, label], i) => {
    const x = 36 + (i % 2) * 194;
    const yy = 578 + (i >> 1) * 42;
    const width = key === "place" && i % 2 === 0 ? 372 : 180;
    c.fillStyle = muted;
    c.font = FM()(10);
    c.fillText(label, x, yy);
    c.fillStyle = ink;
    const r = fit(
      f[key as keyof typeof f],
      FM(500),
      width,
      22,
      16,
      12,
      1.1,
      label[0] + label.slice(1).toLowerCase(),
    );
    c.fillText(r.ls[0], x, yy + 19);
  });

  if (show.qr) drawQr(c, f.url.trim() || `ticketer:${f.serial}`, 450, 574, 108, warnings);

  c.strokeStyle = rgba(st.ink, 0.42);
  c.lineWidth = 2;
  c.setLineDash([7, 7]);
  c.beginPath();
  c.moveTo(NOTCH_R + 14, NOTCH_Y);
  c.lineTo(W - NOTCH_R - 14, NOTCH_Y);
  c.stroke();
  c.setLineDash([]);

  drawStub(c, S, fit, on, ink, muted);
  c.restore();

  punch(
    c,
    S,
    W,
    H,
    [
      [0, NOTCH_Y + dy],
      [W, NOTCH_Y + dy],
    ],
    NOTCH_R,
  );
  return { canvas, warnings };
}

// Below the tear line: a photo strip, square or full stub, then barcode, handle, fine print, caption
function drawStub(
  c: CanvasRenderingContext2D,
  S: TicketState,
  fit: Fit,
  on: (key: string) => boolean,
  ink: string,
  muted: string,
) {
  const { f, sa } = S;
  let I = ink;
  let M = muted;
  let ix = 36;
  let bw = 300;

  if (sa.layout === "cover") {
    drawCover(c, S.stub, 16, 722, 568, 262, sa.r + 6, S.flt);
    const g = c.createLinearGradient(0, 722, 0, 984);
    g.addColorStop(0, "rgba(0,0,0,.6)");
    g.addColorStop(0.5, "rgba(0,0,0,.1)");
    g.addColorStop(1, "rgba(0,0,0,.75)");
    c.fillStyle = g;
    c.beginPath();
    c.roundRect(16, 722, 568, 262, sa.r + 6);
    c.fill();
    I = "#fff";
    M = "rgba(255,255,255,.88)";
  }

  const square = sa.layout === "square";
  if (square) {
    drawCover(c, S.stub, 36, 744, sa.sq, sa.sq, sa.r, S.flt);
    ix = 58 + sa.sq;
    bw = Math.min(300, 564 - ix);
  }

  const by = square || sa.layout === "cover" ? 744 : 736;

  if (on("serial")) {
    barcode(c, f.serial, ix, by, bw, 58, I);
    c.fillStyle = I;
    c.font = FM(500)(14);
    c.fillText(`NO. ${f.serial}`, ix, by + 84);
  }
  if (on("handle")) {
    c.fillStyle = I;
    const r = fit(f.handle, FM(500), square ? 564 - ix : 210, 22, 17, 12, 1.1, "Handle");
    c.textAlign = square ? "left" : "right";
    c.fillText(r.ls[0], square ? ix : 564, square ? by + 112 : 762);
    c.textAlign = "left";
  }
  if (sa.layout === "band") drawCover(c, S.stub, 16, 924 - sa.h, 568, sa.h, sa.r, S.flt);
  if (on("fine")) {
    c.fillStyle = M;
    const r = fit(f.fine, FM(), 528, 14, 11, 10, 1.1, "Fine print");
    c.fillText(r.ls[0], 36, 947);
  }
  if (on("cap")) {
    c.fillStyle = I;
    c.save();
    c.translate(36, 982);
    c.rotate(-0.02);
    const r = fit(f.cap, FC, 520, 30, 30, 19, 1, "Caption");
    c.fillText(r.ls[0], 0, 0);
    c.restore();
  }
}
</file>

<file path="src/lib/ticket/render/drawPoster.ts">
import { makeStock, withInk } from "../color";
import type { Preset } from "../presets";
import { backdropClock, drawAnimatedBackdrop, drawStaticBackdrop } from "./backdrop";
import { renderBack } from "./back";
import { layoutGroup } from "./layout";
import { TEMPLATES } from "./templates";
import type { TicketState } from "./types";

export type DrawOptions = {
  // Leave the backdrop out so a "ticket only" export has a transparent background
  transparent?: boolean;
  // Draw only the tickets. The preview animates the backdrop on a canvas of its own behind them.
  noBackdrop?: boolean;
  // Phase of the animated backdrop in seconds. Defaults to where the preview is now.
  time?: number;
};

// Draws the whole poster (backdrop plus one to three tickets) onto the canvas.
// The canvas size sets the resolution. Returns warnings, like text that had to be trimmed.
export function drawPoster(
  canvas: HTMLCanvasElement,
  preset: Preset,
  S: TicketState,
  options: DrawOptions = {},
): string[] {
  const W = canvas.width;
  const H = canvas.height;
  const u = W / preset.w;
  const c = canvas.getContext("2d")!;
  const { acc } = S;
  c.clearRect(0, 0, W, H);

  if (!(options.transparent && preset.bare) && !options.noBackdrop) {
    if (S.backdrop === "flow" || S.backdrop === "aurora") {
      drawAnimatedBackdrop(c, W, H, acc, S.backdrop, options.time ?? backdropClock.t);
    } else {
      drawStaticBackdrop(c, S.backdrop, acc, S.main, W, H);
    }
  }

  const [top, bottom, side] = preset.safe;
  const pad = (preset.bare ? 0 : 56) * u;
  const availW = W - 2 * pad - 2 * side * u;
  const availH = H - (top + bottom) * u - 2 * pad;
  const group = layoutGroup(S.tpl, S.layout, S.tilt, S.dy);
  const k = Math.min(availW / group.bounds.w, availH / group.bounds.h);
  const originY = top * u + (H - (top + bottom) * u) / 2;
  const warnings: string[] = [];

  for (const item of group.items) {
    const ticket: TicketState = {
      ...S,
      main: item.swap ? S.stub : S.main,
      stub: item.swap ? S.main : S.stub,
      st: item.stock ? withInk(makeStock(item.stock, acc), S.inkOverride) : S.st,
    };
    const render = S.back ? renderBack : TEMPLATES[S.tpl].render;
    const { canvas: rendered, warnings: w } = render(ticket, k);

    c.save();
    if (!preset.bare) {
      c.shadowColor = `rgba(0,0,0,${(0.45 * S.shadow) / 100})`;
      c.shadowBlur = 40 * u;
      c.shadowOffsetY = 18 * u;
    }
    c.translate(W / 2 + (item.x - group.bounds.cx) * k, originY + (item.y - group.bounds.cy) * k);
    c.rotate(item.r);
    c.drawImage(rendered, -rendered.width / 2, -rendered.height / 2);
    c.restore();
    warnings.push(...w);
  }

  return [...new Set(warnings)];
}
</file>

<file path="src/lib/ticket/render/frame.ts">
import { clamp } from "../math";
import { shownAspect } from "../photo";
import type { MainShape } from "../settings";
import type { Photo } from "../types";
import type { Template } from "./types";

// Size of the main photo frame: [width, height, extra height over the template's base]
// With "auto", the frame follows the photo's own aspect ratio, within what the template can hold.
export function mainFrame(
  box: Template["photoBox"],
  shape: MainShape,
  main: Photo | null,
  stubWidth: number,
): [number, number, number] {
  const [boxW, boxH, minScale, maxScale] = box;
  const w = ((boxW || 836 - stubWidth) * shape.w) / 100;
  let h = (boxH * shape.h) / 100;

  if (shape.auto && main) h = w / shownAspect(main);

  h = clamp(h, boxH * minScale, boxH * maxScale);
  return [w, h, h - boxH];
}
</file>

<file path="src/lib/ticket/render/layout.ts">
import type { LayoutId, TemplateId } from "../ids";
import { TEMPLATES } from "./templates";

export type Placement = {
  x: number;
  y: number;
  r: number;
  // Lead with the stub photo instead of the main one
  swap: boolean;
  // Paper stock override, for the variations layout
  stock?: "light" | "dark" | "tint";
};

// Where each ticket sits in a group, in design units. One ticket, two angled, or three variations.
export function layoutGroup(tpl: TemplateId, layout: LayoutId, tilt: number, dy = 0) {
  const [tw, baseH] = TEMPLATES[tpl].size;
  const th = baseH + dy;
  const tall = baseH > tw;

  const defs: Record<LayoutId, Omit<Placement, "r">[]> = {
    single: [{ x: 0, y: 0, swap: false }],
    twin: tall
      ? [
          { x: -340, y: -50, swap: false },
          { x: 340, y: 50, swap: true },
        ]
      : [
          { x: -40, y: -th / 2 - 40, swap: false },
          { x: 40, y: th / 2 + 40, swap: true },
        ],
    var: tall
      ? [
          { x: -660, y: 0, swap: false, stock: "light" },
          { x: 0, y: 0, swap: false, stock: "dark" },
          { x: 660, y: 0, swap: false, stock: "tint" },
        ]
      : [
          { x: 0, y: -th - 50, swap: false, stock: "light" },
          { x: 0, y: 0, swap: false, stock: "dark" },
          { x: 0, y: th + 50, swap: false, stock: "tint" },
        ],
  };

  const rotation = (layout === "twin" ? (tall ? 0.12 : -0.5) : 0) + (tilt * Math.PI) / 180;
  const cos = Math.cos(rotation);
  const sin = Math.sin(rotation);

  const items: Placement[] = defs[layout].map((d) => ({
    ...d,
    x: d.x * cos - d.y * sin,
    y: d.x * sin + d.y * cos,
    r: rotation,
  }));

  let x0 = Infinity;
  let x1 = -Infinity;
  let y0 = Infinity;
  let y1 = -Infinity;
  for (const item of items) {
    for (const [sx, sy] of [
      [1, 1],
      [1, -1],
      [-1, 1],
      [-1, -1],
    ]) {
      const px = (sx * tw) / 2;
      const py = (sy * th) / 2;
      const X = item.x + px * cos - py * sin;
      const Y = item.y + px * sin + py * cos;
      x0 = Math.min(x0, X);
      x1 = Math.max(x1, X);
      y0 = Math.min(y0, Y);
      y1 = Math.max(y1, Y);
    }
  }

  return {
    items,
    bounds: { w: x1 - x0, h: y1 - y0, cx: (x0 + x1) / 2, cy: (y0 + y1) / 2 },
  };
}
</file>

<file path="src/lib/ticket/render/shared.ts">
import qrcode from "qrcode-generator";

import { rgb, rgba } from "../color";
import type { FieldKey } from "../fields";
import { drawCover } from "../photo";
import type { TicketState } from "./types";

export const FB = (s: number) => `800 ${s}px "Bricolage Grotesque"`;
export const FM =
  (weight = 400) =>
  (s: number) =>
    `${weight} ${s}px "DM Mono"`;
export const FC = (s: number) => `600 ${s}px Caveat`;

// Fonts the canvas needs before it draws
export const TICKET_FONTS = [
  '800 40px "Bricolage Grotesque"',
  '500 16px "DM Mono"',
  "600 28px Caveat",
];

type Ctx = CanvasRenderingContext2D;

export type Fit = (
  text: string,
  font: (size: number) => string,
  maxWidth: number,
  maxHeight: number,
  maxSize: number,
  minSize: number,
  lineHeight: number,
  label: string,
) => { s: number; ls: string[] };

// Shrinks text until it fits the box, wrapping on spaces. Leaves the canvas font set to the result.
export function makeFit(c: Ctx, warnings: string[]): Fit {
  const wrap = (text: string, maxWidth: number) => {
    const lines: string[] = [];
    let line = "";
    for (const word of text.split(/\s+/)) {
      const next = line ? `${line} ${word}` : word;
      if (c.measureText(next).width > maxWidth && line) {
        lines.push(line);
        line = word;
      } else {
        line = next;
      }
    }
    if (line) lines.push(line);
    return lines;
  };

  return (text, font, maxWidth, maxHeight, maxSize, minSize, lineHeight, label) => {
    for (let s = maxSize; s >= minSize; s--) {
      c.font = font(s);
      const ls = wrap(text, maxWidth);
      if (
        ls.length * s * lineHeight <= maxHeight &&
        ls.every((l) => c.measureText(l).width <= maxWidth)
      ) {
        return { s, ls };
      }
    }
    c.font = font(minSize);
    warnings.push(`${label} is very long and was trimmed to stay legible`);
    return {
      s: minSize,
      ls: wrap(text, maxWidth).slice(
        0,
        Math.max(1, Math.floor(maxHeight / (minSize * lineHeight))),
      ),
    };
  };
}

let noiseCanvas: HTMLCanvasElement | null = null;

// Static grain texture, made once
function getNoise() {
  if (noiseCanvas) return noiseCanvas;
  const n = document.createElement("canvas");
  n.width = n.height = 96;
  const g = n.getContext("2d")!;
  const data = g.createImageData(96, 96);
  let seed = 7;
  for (let i = 0; i < data.data.length; i += 4) {
    seed = (seed * 16807) % 2147483647;
    data.data[i] = data.data[i + 1] = data.data[i + 2] = seed % 255;
    data.data[i + 3] = 255;
  }
  g.putImageData(data, 0, 0);
  noiseCanvas = n;
  return n;
}

// A canvas sized for the scale, clipped to the ticket outline and filled with paper.
// Pair it with punch() once everything is drawn.
export function createTicketCanvas(
  S: TicketState,
  k: number,
  W: number,
  H: number,
  radius: number,
) {
  const canvas = document.createElement("canvas");
  canvas.width = Math.round(W * k);
  canvas.height = Math.round(H * k);
  const c = canvas.getContext("2d")!;
  c.scale(canvas.width / W, canvas.height / H);
  c.save();
  c.beginPath();
  c.roundRect(0, 0, W, H, S.corn ? 0 : radius);
  c.clip();
  c.globalAlpha = S.st.alpha;
  c.fillStyle = rgb(S.st.paper);
  c.fillRect(0, 0, W, H);
  c.globalAlpha = 1;
  if (S.grain) {
    c.globalAlpha = 0.08;
    c.fillStyle = c.createPattern(getNoise(), "repeat")!;
    c.fillRect(0, 0, W, H);
    c.globalAlpha = 1;
  }
  return { canvas, c };
}

// Cuts half circles out of the edge (the tear notches) and, with notched corners on, the corners
export function punch(
  c: Ctx,
  S: TicketState,
  W: number,
  H: number,
  notches: [number, number][],
  radius = 20,
) {
  c.restore();
  c.globalCompositeOperation = "destination-out";
  c.beginPath();
  for (const [x, y] of notches) {
    c.moveTo(x + radius, y);
    c.arc(x, y, radius, 0, 7);
  }
  if (S.corn) {
    for (const [x, y] of [
      [0, 0],
      [W, 0],
      [0, H],
      [W, H],
    ]) {
      c.moveTo(x + 20, y);
      c.arc(x, y, 20, 0, 7);
    }
  }
  c.fill();
  c.globalCompositeOperation = "source-over";
}

export function barcode(
  c: Ctx,
  text: string,
  x: number,
  y: number,
  w: number,
  h: number,
  color: string,
) {
  const bits = [1, 0, 1, 0];
  for (const ch of text) for (let i = 7; i >= 0; i--) bits.push((ch.charCodeAt(0) >> i) & 1);
  bits.push(0, 1, 0, 1);
  const unit = w / bits.length;
  c.fillStyle = color;
  bits.forEach((bit, i) => bit && c.fillRect(x + i * unit, y, unit + 0.3, h));
}

export function drawQr(
  c: Ctx,
  text: string,
  x: number,
  y: number,
  size: number,
  warnings: string[],
  pad = 8,
  radius = 10,
) {
  try {
    const qr = qrcode(0, "M");
    qr.addData(text);
    qr.make();
    const n = qr.getModuleCount();
    const unit = size / n;
    c.fillStyle = "#F6F2E9";
    c.beginPath();
    c.roundRect(x - pad, y - pad, size + pad * 2, size + pad * 2, radius);
    c.fill();
    c.fillStyle = "#1B1A17";
    for (let r = 0; r < n; r++) {
      for (let j = 0; j < n; j++) {
        if (qr.isDark(r, j)) c.fillRect(x + j * unit, y + r * unit, unit + 0.5, unit + 0.5);
      }
    }
  } catch {
    warnings.push("QR link is too long to encode");
  }
}

// The main photo with the shape settings applied (width, corner radius, frame, text shade)
export function drawMainPhoto(
  c: Ctx,
  S: TicketState,
  x: number,
  y: number,
  w: number,
  h: number,
  shade: number,
) {
  const { mp } = S;
  const width = (w * mp.w) / 100;
  const left = x + (w - width) / 2;

  drawCover(c, S.main, left, y, width, h, mp.r, S.flt);

  c.save();
  c.beginPath();
  c.roundRect(left, y, width, h, mp.r);
  c.clip();
  const shadeH = Math.min(h * 0.5, 200);
  const g = c.createLinearGradient(0, y + h - shadeH, 0, y + h);
  g.addColorStop(0, "rgba(0,0,0,0)");
  g.addColorStop(1, `rgba(0,0,0,${(shade * mp.s) / 100})`);
  c.fillStyle = g;
  c.fillRect(left, y + h - shadeH, width, shadeH);
  c.restore();

  if (mp.b > 0) {
    c.save();
    c.lineWidth = mp.b;
    c.strokeStyle = rgb(S.st.ink);
    c.beginPath();
    c.roundRect(
      left + mp.b / 2,
      y + mp.b / 2,
      width - mp.b,
      h - mp.b,
      Math.max(0, mp.r - mp.b / 2),
    );
    c.stroke();
    c.restore();
  }
}
type Kit = ReturnType<typeof ticketKit>;
export type { Kit };

// Everything a template needs at the start of a render: a canvas on paper, colour strings,
// a text fitter and a way to ask whether a field is shown and filled in.
export function ticketKit(S: TicketState, k: number, W: number, baseH: number, radius: number) {
  const dy = S.dy;
  const H = baseH + dy;
  const warnings: string[] = [];
  const { canvas, c } = createTicketCanvas(S, k, W, H, radius);
  const { st, f, show } = S;

  return {
    canvas,
    c,
    W,
    H,
    dy,
    f,
    show,
    st,
    warnings,
    fit: makeFit(c, warnings),
    on: (key: FieldKey) => Boolean(show[key] && f[key]?.trim()),
    A: rgb(st.acc),
    OA: rgb(st.onacc),
    I: rgb(st.ink),
    M: rgba(st.ink, 0.74),
  };
}

// A pill with a short label, used for tier and info lines
export function chipAt(c: Ctx, fit: Fit, text: string, x: number, y: number, A: string, OA: string) {
  const r = fit(text, FM(500), 380, 20, 13, 11, 1, "Label");
  const w = c.measureText(r.ls[0]).width + 28;
  c.fillStyle = A;
  c.beginPath();
  c.roundRect(x, y, w, 30, 15);
  c.fill();
  c.fillStyle = OA;
  c.textAlign = "left";
  c.fillText(r.ls[0], x + 14, y + 20);
}

// The round "ADMIT ONE" stamp. `at` is the template's own spot, `S.sp` moves it.
export function stampAt(
  c: Ctx,
  S: TicketState,
  W: number,
  H: number,
  at: [number, number],
  A: string,
  OA: string,
) {
  const [x, y] = S.sp ? [S.sp.x * W, S.sp.y * H] : at;
  c.save();
  c.translate(x, y);
  c.scale(S.ssc, S.ssc);
  c.rotate(-0.24);
  c.fillStyle = A;
  c.beginPath();
  c.arc(0, 0, 44, 0, 7);
  c.fill();
  c.fillStyle = OA;
  c.textAlign = "center";
  c.font = '800 17px "Bricolage Grotesque"';
  c.fillText("ADMIT", 0, -2);
  c.fillText("ONE", 0, 17);
  c.restore();
}

// The dashed tear line
export function tearLine(c: Ctx, S: TicketState, x1: number, y1: number, x2: number, y2: number) {
  c.strokeStyle = rgba(S.st.ink, 0.42);
  c.lineWidth = 2;
  c.setLineDash([7, 7]);
  c.beginPath();
  c.moveTo(x1, y1);
  c.lineTo(x2, y2);
  c.stroke();
  c.setLineDash([]);
}

// Postage-stamp edge: half circles cut out all the way round
export function scallop(c: Ctx, W: number, H: number) {
  c.globalCompositeOperation = "destination-out";
  c.beginPath();
  for (let x = 11; x < W; x += 22) {
    c.moveTo(x + 7, 0);
    c.arc(x, 0, 7, 0, 7);
    c.moveTo(x + 7, H);
    c.arc(x, H, 7, 0, 7);
  }
  for (let y = 11; y < H; y += 22) {
    c.moveTo(7, y);
    c.arc(0, y, 7, 0, 7);
    c.moveTo(W + 7, y);
    c.arc(W, y, 7, 0, 7);
  }
  c.fill();
  c.globalCompositeOperation = "source-over";
}

// What the QR code encodes: the link, or the serial when no link is set
export const qrText = (S: TicketState) => S.f.url.trim() || `ticketer:${S.f.serial}`;
</file>

<file path="src/lib/ticket/render/state.ts">
import { makeStock, withInk, type RGB } from "../color";
import type { FieldKey } from "../fields";
import type { TemplateId } from "../ids";
import { dominantColor } from "../photo";
import type { Settings } from "../settings";
import type { Photo } from "../types";
import { mainFrame } from "./frame";
import { TEMPLATES } from "./templates";
import type { TicketState } from "./types";

export type Photos = { main: Photo | null; stub: Photo | null };

// Things that change how a ticket is drawn without being saved settings
export type ViewOptions = {
  // Draw this template instead of the saved one (used by "recompose")
  tpl?: TemplateId;
  back?: boolean;
  // Stamp scale while it thumps
  stampScale?: number;
};

const FX: Record<Settings["adjust"]["fx"], string> = {
  none: "",
  warm: "sepia(.28) saturate(1.2)",
  cool: "hue-rotate(-14deg) saturate(1.1)",
  film: "contrast(1.08) sepia(.18) saturate(.9)",
  noir: "grayscale(1) contrast(1.15)",
};

const FALLBACK_ACCENT: RGB = [194, 68, 30];

export const photoFilter = (adjust: Settings["adjust"]) =>
  `brightness(${adjust.brightness}%) contrast(${adjust.contrast}%) grayscale(${adjust.grayscale ? 1 : 0}) ${FX[adjust.fx]}`;

// Turns the saved settings and the current photos into what a template draws
export function buildTicketState(
  settings: Settings,
  photos: Photos,
  view: ViewOptions = {},
): TicketState {
  const tpl = view.tpl ?? settings.tpl;
  const template = TEMPLATES[tpl];
  const accent =
    settings.accent ?? (photos.main ? dominantColor(photos.main.bmp) : FALLBACK_ACCENT);
  const [, , dy] = mainFrame(
    template.photoBox,
    settings.mainShape,
    photos.main,
    settings.stubArea.mw,
  );

  return {
    tpl,
    main: photos.main,
    // The stub falls back to the main photo until a separate one is added
    stub: photos.stub ?? photos.main,
    f: settings.fields as Record<FieldKey, string>,
    show: settings.show,
    st: withInk(makeStock(settings.stock, accent), settings.ink),
    acc: accent,
    flt: photoFilter(settings.adjust),
    grain: settings.grain,
    corn: settings.notched,
    sa: settings.stubArea,
    mp: settings.mainShape,
    dy,
    sp: settings.stampPos,
    ssc: view.stampScale ?? 1,
    back: view.back ?? false,
    prog: settings.progress,
    layout: settings.layout,
    tilt: settings.tilt,
    shadow: settings.shadow,
    backdrop: settings.backdrop,
    inkOverride: settings.ink,
  };
}
</file>

