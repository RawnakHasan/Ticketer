<file path="src/lib/loadingMotion.ts">
// Motion of the M3 loading indicator, same numbers as LoadingIndicatorAnimatorDelegate on Android.
// Every 650ms the morph target moves on to the next shape, and a spring (so it overshoots a
// little) chases it. The rotation is a constant spin plus an extra kick on every morph.
export const DURATION_PER_SHAPE_MS = 650;
const CONSTANT_ROTATION_DEG = 50;
const EXTRA_ROTATION_DEG = 90;
const SPRING_STIFFNESS = 200;
const SPRING_DAMPING_RATIO = 0.6;
const SPRING_DAMPING = 2 * SPRING_DAMPING_RATIO * Math.sqrt(SPRING_STIFFNESS);

export type LoadingMotion = {
  // Morph position: the whole part is the current shape, the rest how far it is toward the next
  position: number;
  velocity: number;
  // The position the spring is heading for, goes up by one per shape
  target: number;
  // Time into the current shape
  elapsed: number;
};

export const createLoadingMotion = (): LoadingMotion => ({
  position: 0,
  velocity: 0,
  target: 1,
  elapsed: 0,
});

export function stepLoadingMotion(m: LoadingMotion, deltaMs: number) {
  m.elapsed += deltaMs;
  while (m.elapsed >= DURATION_PER_SHAPE_MS) {
    m.elapsed -= DURATION_PER_SHAPE_MS;
    m.target += 1;
  }

  // Small fixed steps keep the spring stable at any frame rate
  const seconds = deltaMs / 1000;
  const steps = Math.max(1, Math.ceil(seconds * 240));
  const h = seconds / steps;
  for (let i = 0; i < steps; i++) {
    const acceleration = -SPRING_STIFFNESS * (m.position - m.target) - SPRING_DAMPING * m.velocity;
    m.velocity += acceleration * h;
    m.position += m.velocity * h;
  }
}

// Rotation of the indicator in degrees
export function loadingRotation(m: LoadingMotion): number {
  const base = m.target - 1;
  return (
    ((CONSTANT_ROTATION_DEG + EXTRA_ROTATION_DEG) * base +
      CONSTANT_ROTATION_DEG * (m.elapsed / DURATION_PER_SHAPE_MS) +
      EXTRA_ROTATION_DEG * (m.position - base)) %
    360
  );
}
</file>

<file path="src/lib/motion.ts">
// Small animation helpers shared by the progress and loading indicators.

export const clamp = (value: number, min: number, max: number) =>
  Math.min(Math.max(value, min), max);

// How far `time` is through a range that starts at `start` and lasts `duration`, in [0, 1]
export const rangeProgress = (time: number, start: number, duration: number) =>
  clamp((time - start) / duration, 0, 1);

// Same as CSS cubic-bezier(): x is time and y is progress, both in [0, 1]
export function cubicBezier(x1: number, y1: number, x2: number, y2: number) {
  const bezier = (a: number, b: number, s: number) => {
    const u = 1 - s;
    return 3 * u * u * s * a + 3 * u * s * s * b + s * s * s;
  };
  const slope = (a: number, b: number, s: number) => {
    const u = 1 - s;
    return 3 * u * u * a + 6 * u * s * (b - a) + 3 * s * s * (1 - b);
  };
  return (t: number) => {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    // Newton's method finds the curve parameter whose x is t, bisection is the fallback
    let s = t;
    for (let i = 0; i < 8; i++) {
      const error = bezier(x1, x2, s) - t;
      if (Math.abs(error) < 1e-6) return bezier(y1, y2, s);
      const d = slope(x1, x2, s);
      if (Math.abs(d) < 1e-6) break;
      s -= error / d;
    }
    let lo = 0;
    let hi = 1;
    s = t;
    for (let i = 0; i < 30; i++) {
      const x = bezier(x1, x2, s);
      if (Math.abs(x - t) < 1e-6) break;
      if (x < t) lo = s;
      else hi = s;
      s = (lo + hi) / 2;
    }
    return bezier(y1, y2, s);
  };
}

// M3 motion easing tokens
export const standardEasing = cubicBezier(0.2, 0, 0, 1);
export const emphasizedAccelerateEasing = cubicBezier(0.3, 0, 0.8, 0.15);

// A damped spring (mass 1) pulling `value` toward `target`, like Android's SpringForce
export class Spring {
  value: number;
  target: number;
  velocity = 0;
  private readonly stiffness: number;
  private readonly damping: number;

  constructor(value: number, options: { stiffness: number; dampingRatio: number }) {
    this.value = value;
    this.target = value;
    this.stiffness = options.stiffness;
    this.damping = 2 * options.dampingRatio * Math.sqrt(options.stiffness);
  }

  step(seconds: number) {
    // Small fixed steps keep the integration stable however long a frame took
    const h = 1 / 240;
    let remaining = seconds;
    while (remaining > 1e-9) {
      const d = Math.min(h, remaining);
      const acceleration =
        -this.stiffness * (this.value - this.target) - this.damping * this.velocity;
      this.velocity += acceleration * d;
      this.value += this.velocity * d;
      remaining -= d;
    }
  }

  // minChange is the smallest change that is still visible, in the units of the value
  isAtRest(minChange: number) {
    return (
      Math.abs(this.value - this.target) < minChange && Math.abs(this.velocity) < minChange * 62.5
    );
  }
}

// Calls step on every animation frame until it returns false. Returns a function that stops it.
export function runAnimationLoop(step: (dtMs: number, nowMs: number) => boolean | void) {
  let frame = 0;
  let last: number | null = null;
  const tick = (now: number) => {
    // Time spent in a background tab shouldn't make the animation jump
    const dt = last === null ? 0 : Math.min(now - last, 64);
    last = now;
    if (step(dt, now) === false) return;
    frame = requestAnimationFrame(tick);
  };
  frame = requestAnimationFrame(tick);
  return () => cancelAnimationFrame(frame);
}
</file>

<file path="src/lib/progressGeometry.ts">
// Path builders for the M3 Expressive progress indicators. Every shape is a stroke with round
// caps, so a bar or an arc is a centerline plus a stroke width. Linear bars run along x and sit
// on y = 0. Circular arcs are around the origin, with 0 degrees at the top, going clockwise.

import { Cubic } from "@/lib/shapes/geometry";

export type Stroke = { d: string; width: number };

export const NO_STROKE: Stroke = { d: "", width: 0 };

// Control handle of each half wave, as a fraction of the half wavelength (same as Android)
const WAVE_SMOOTHNESS = 0.48;

const f = (n: number) => +n.toFixed(2);

export function setStroke(el: SVGElement | null | undefined, stroke: Stroke) {
  if (!el) return;
  el.setAttribute("d", stroke.d);
  el.setAttribute("stroke-width", String(stroke.width));
}

// ---------------------------------------------------------------------------------------------
// Linear

// A straight bar from x0 to x1. Shorter than it is thick, it shrinks into a dot.
export function flatBar(x0: number, x1: number, thickness: number): Stroke {
  const length = x1 - x0;
  if (length <= 0) return NO_STROKE;
  const width = Math.min(thickness, length);
  const r = width / 2;
  return { d: `M${f(x0 + r)} 0H${f(x1 - r)}`, width };
}

// Finds the curve parameter where a cubic that only goes right reaches x
function solveX(cubic: Cubic, x: number) {
  let lo = 0;
  let hi = 1;
  for (let i = 0; i < 24; i++) {
    const mid = (lo + hi) / 2;
    if (cubic.pointOnCurve(mid).x < x) lo = mid;
    else hi = mid;
  }
  return (lo + hi) / 2;
}

// A bar from x0 to x1 that follows a wave. The wave is anchored to the track, not to the bar,
// so the bar slides over it. `phase` is how many wavelengths the wave has moved.
export function wavyBar(
  x0: number,
  x1: number,
  thickness: number,
  amplitude: number,
  wavelength: number,
  phase: number,
): Stroke {
  const r = thickness / 2;
  // The round caps cover the first and last r of the bar
  const a = x0 + r;
  const b = x1 - r;
  if (b <= a || amplitude < 0.01) return flatBar(x0, x1, thickness);

  const half = wavelength / 2;
  const anchorX = (k: number) => half * (k - 2 * phase);
  // Even anchors are the low points (y grows downward), odd ones the high points
  const anchorY = (k: number) => (((k % 2) + 2) % 2 === 0 ? amplitude : -amplitude);

  let d = "";
  for (let k = Math.floor(a / half + 2 * phase); anchorX(k) < b; k++) {
    let seg = new Cubic([
      anchorX(k),
      anchorY(k),
      anchorX(k) + WAVE_SMOOTHNESS * half,
      anchorY(k),
      anchorX(k + 1) - WAVE_SMOOTHNESS * half,
      anchorY(k + 1),
      anchorX(k + 1),
      anchorY(k + 1),
    ]);
    if (anchorX(k) < a) seg = seg.split(solveX(seg, a))[1];
    if (anchorX(k + 1) > b) seg = seg.split(solveX(seg, b))[0];
    if (d === "") d = `M${f(seg.p[0])} ${f(seg.p[1])}`;
    d += `C${f(seg.p[2])} ${f(seg.p[3])} ${f(seg.p[4])} ${f(seg.p[5])} ${f(seg.p[6])} ${f(seg.p[7])}`;
  }
  return { d, width: thickness };
}

// ---------------------------------------------------------------------------------------------
// Circular

const toRadians = (degrees: number) => (degrees * Math.PI) / 180;
const toDegrees = (radians: number) => (radians * 180) / Math.PI;

export const arcDegrees = toDegrees;

const pointAt = (radius: number, degrees: number) => ({
  x: radius * Math.sin(toRadians(degrees)),
  y: -radius * Math.cos(toRadians(degrees)),
});

// An arc of the circle with the given radius. Shorter than the round caps, it shrinks into a dot.
export function flatArc(
  radius: number,
  startDeg: number,
  sweepDeg: number,
  thickness: number,
): Stroke {
  if (sweepDeg <= 0) return NO_STROKE;
  // The angle that one round cap covers
  const capDeg = toDegrees(thickness / 2 / radius);
  if (sweepDeg < capDeg * 2) {
    const shrink = sweepDeg / (capDeg * 2);
    const p = pointAt(radius, startDeg + capDeg * shrink);
    return { d: `M${f(p.x)} ${f(p.y)}h0`, width: thickness * shrink };
  }
  const start = startDeg + capDeg;
  const sweep = sweepDeg - capDeg * 2;
  // An SVG arc can't be a full circle, and is ambiguous at 180 degrees: use pieces of 120
  const pieces = Math.max(1, Math.ceil(sweep / 120));
  const p0 = pointAt(radius, start);
  let d = `M${f(p0.x)} ${f(p0.y)}`;
  for (let i = 1; i <= pieces; i++) {
    const p = pointAt(radius, start + (sweep * i) / pieces);
    d += `A${f(radius)} ${f(radius)} 0 0 1 ${f(p.x)} ${f(p.y)}`;
  }
  return { d, width: thickness };
}

// Polar angle of a point, in degrees from the top, brought within 180 degrees of `near`
function angleOf(x: number, y: number, near: number) {
  const a = toDegrees(Math.atan2(x, -y));
  return near + ((((a - near) % 360) + 540) % 360) - 180;
}

// Finds the curve parameter where a cubic that only goes clockwise reaches an angle
function solveAngle(cubic: Cubic, degrees: number) {
  let lo = 0;
  let hi = 1;
  for (let i = 0; i < 24; i++) {
    const mid = (lo + hi) / 2;
    const p = cubic.pointOnCurve(mid);
    if (angleOf(p.x, p.y, degrees) < degrees) lo = mid;
    else hi = mid;
  }
  return (lo + hi) / 2;
}

// An arc that follows a wave around the circle. The wave dips toward the center, so the track's
// outer edge stays on the circle. `phase` is how many wavelengths the wave has moved.
export function wavyArc(
  radius: number,
  startDeg: number,
  sweepDeg: number,
  thickness: number,
  amplitude: number,
  wavelength: number,
  phase: number,
): Stroke {
  const capDeg = toDegrees(thickness / 2 / radius);
  if (sweepDeg < capDeg * 2 || amplitude < 0.01)
    return flatArc(radius, startDeg, sweepDeg, thickness);

  // Whole number of cycles per circle, at least 3
  const cycles = Math.max(3, Math.floor((2 * Math.PI * radius) / wavelength));
  const halfStep = 180 / cycles;
  const handle = ((Math.PI * radius) / cycles) * WAVE_SMOOTHNESS;
  const anchorDeg = (k: number) => halfStep * (k - 2 * phase);
  const anchorR = (k: number) => (((k % 2) + 2) % 2 === 0 ? radius : radius - 2 * amplitude);
  const anchor = (k: number) => pointAt(anchorR(k), anchorDeg(k));
  // Direction of travel at an anchor: the tangent of the circle
  const tangent = (k: number) => ({
    x: Math.cos(toRadians(anchorDeg(k))),
    y: Math.sin(toRadians(anchorDeg(k))),
  });

  const a = startDeg + capDeg;
  const b = startDeg + sweepDeg - capDeg;
  let d = "";
  for (let k = Math.floor(a / halfStep + 2 * phase); anchorDeg(k) < b; k++) {
    const p0 = anchor(k);
    const p1 = anchor(k + 1);
    const t0 = tangent(k);
    const t1 = tangent(k + 1);
    let seg = new Cubic([
      p0.x,
      p0.y,
      p0.x + t0.x * handle,
      p0.y + t0.y * handle,
      p1.x - t1.x * handle,
      p1.y - t1.y * handle,
      p1.x,
      p1.y,
    ]);
    if (anchorDeg(k) < a) seg = seg.split(solveAngle(seg, a))[1];
    if (anchorDeg(k + 1) > b) seg = seg.split(solveAngle(seg, b))[0];
    if (d === "") d = `M${f(seg.p[0])} ${f(seg.p[1])}`;
    d += `C${f(seg.p[2])} ${f(seg.p[3])} ${f(seg.p[4])} ${f(seg.p[5])} ${f(seg.p[6])} ${f(seg.p[7])}`;
  }
  return { d, width: thickness };
}
</file>

<file path="src/lib/progressMotion.ts">
// The motion of the M3 Expressive progress indicators, ported from the animator delegates in
// material-components-android (DeterminateDrawable and the indeterminate animator delegates).

import {
  Spring,
  clamp,
  cubicBezier,
  emphasizedAccelerateEasing,
  rangeProgress,
  standardEasing,
} from "@/lib/motion";

// Wave amplitude is full between these two progress values and ramps to 0 outside of them
const FULL_AMPLITUDE_MIN = 0.1;
const FULL_AMPLITUDE_MAX = 0.9;
const AMPLITUDE_MS = 500;
// One wavelength per second, the speed Compose uses by default
const WAVE_CYCLE_MS = 1000;

// Determinate: progress follows its target with a critically damped spring, the wave fades in
// once there is some progress to show and fades out near the end, and the wave drifts along.
export class DeterminateMotion {
  progress: number;
  amplitude: number;
  phase = 0;
  private readonly spring: Spring;
  private amplitudeFrom: number;
  private amplitudeTarget: number;
  private amplitudeElapsed = AMPLITUDE_MS;

  constructor(progress: number) {
    this.progress = progress;
    this.spring = new Spring(progress, { stiffness: 50, dampingRatio: 1 });
    this.amplitudeTarget = DeterminateMotion.amplitudeFor(progress);
    this.amplitudeFrom = this.amplitudeTarget;
    this.amplitude = this.amplitudeTarget;
  }

  private static amplitudeFor(progress: number) {
    return progress >= FULL_AMPLITUDE_MIN && progress <= FULL_AMPLITUDE_MAX ? 1 : 0;
  }

  setTarget(target: number, animate: boolean) {
    this.spring.target = target;
    if (!animate) {
      this.spring.value = target;
      this.spring.velocity = 0;
      this.progress = target;
      this.amplitudeTarget = DeterminateMotion.amplitudeFor(target);
      this.amplitude = this.amplitudeTarget;
      this.amplitudeElapsed = AMPLITUDE_MS;
    }
  }

  // minChange: the smallest change in progress that is still visible (1 / track length in px)
  step(dtMs: number, minChange: number, driftWave: boolean) {
    this.spring.step(dtMs / 1000);
    if (this.spring.isAtRest(minChange)) {
      this.spring.value = this.spring.target;
      this.spring.velocity = 0;
    }
    this.progress = this.spring.value;

    const target = DeterminateMotion.amplitudeFor(this.progress);
    if (target !== this.amplitudeTarget) {
      this.amplitudeTarget = target;
      this.amplitudeFrom = this.amplitude;
      this.amplitudeElapsed = 0;
    }
    if (this.amplitudeElapsed < AMPLITUDE_MS) {
      this.amplitudeElapsed += dtMs;
      const ease = this.amplitudeTarget === 1 ? standardEasing : emphasizedAccelerateEasing;
      const t = ease(clamp(this.amplitudeElapsed / AMPLITUDE_MS, 0, 1));
      this.amplitude = this.amplitudeFrom + (this.amplitudeTarget - this.amplitudeFrom) * t;
    }
    if (driftWave) this.phase = (this.phase + dtMs / WAVE_CYCLE_MS) % 1;
  }

  // Nothing is moving: no need to draw another frame (unless the wave drifts)
  get settled() {
    return this.progress === this.spring.target && this.amplitudeElapsed >= AMPLITUDE_MS;
  }
}

// Phase of a wave that drifts at one wavelength per second
export const wavePhase = (timeMs: number) => (timeMs / WAVE_CYCLE_MS) % 1;

// ---------------------------------------------------------------------------------------------
// Linear indeterminate: two bars that run across the track, 1.8 seconds per cycle

const LINEAR_CYCLE_MS = 1800;
// Start and end of bar 1, then start and end of bar 2
const LINEAR_DELAY = [1267, 1000, 333, 0];
const LINEAR_DURATION = [533, 567, 850, 750];
const LINEAR_EASING = [
  cubicBezier(0.2, 0, 0.8, 1),
  cubicBezier(0.4, 0, 1, 1),
  cubicBezier(0, 0, 0.65, 1),
  cubicBezier(0.1, 0, 0.45, 1),
];

// Start and end of both bars, as a fraction of the track
export function linearIndeterminate(timeMs: number) {
  const t = timeMs % LINEAR_CYCLE_MS;
  return [0, 1].map((i) => ({
    start: LINEAR_EASING[2 * i](rangeProgress(t, LINEAR_DELAY[2 * i], LINEAR_DURATION[2 * i])),
    end: LINEAR_EASING[2 * i + 1](
      rangeProgress(t, LINEAR_DELAY[2 * i + 1], LINEAR_DURATION[2 * i + 1]),
    ),
  }));
}

// ---------------------------------------------------------------------------------------------
// Circular indeterminate ("retreat"): one arc that grows and shrinks while it turns, 6 seconds
// per cycle

const CIRCULAR_CYCLE_MS = 6000;
const SPIN_DELAYS = [0, 1500, 3000, 4500];
const SPIN_MS = 500;
const SPIN_DEGREES = 90;
// Rotation that never stops, per cycle
const CONSTANT_ROTATION = 1080;
// The arc covers between 10% and 87% of the circle
const END_FRACTION_MIN = 0.1;
const END_FRACTION_MAX = 0.87;

// Rotation in degrees and where the arc ends as a fraction of the circle (it starts at 0)
export function circularIndeterminate(timeMs: number) {
  const t = timeMs % CIRCULAR_CYCLE_MS;
  let spin = 0;
  for (const delay of SPIN_DELAYS)
    spin += standardEasing(rangeProgress(t, delay, SPIN_MS)) * SPIN_DEGREES;
  const grow =
    standardEasing(rangeProgress(t, 0, 3000)) - standardEasing(rangeProgress(t, 3000, 3000));
  return {
    rotation: CONSTANT_ROTATION * (t / CIRCULAR_CYCLE_MS) + spin,
    end: END_FRACTION_MIN + (END_FRACTION_MAX - END_FRACTION_MIN) * grow,
  };
}
