import { create } from "zustand";
import { persist } from "zustand/middleware";

import { hexColor, paletteSchema, type PaletteVariant } from "@/lib/palette/schema";

type PaletteState = {
  seed: string | null;
  variant: PaletteVariant;
  setSeed: (seed: string) => void;
  setVariant: (variant: PaletteVariant) => void;
  reset: () => void;
};

export const PALETTE_STORAGE_KEY = "vite-ui-palette";

export const usePaletteStore = create<PaletteState>()(
  persist(
    (set) => ({
      seed: null,
      variant: "tonalSpot",
      setSeed: (seed) => set({ seed: hexColor.parse(seed).toLowerCase() }),
      setVariant: (variant) => set({ variant }),
      reset: () => set({ seed: null, variant: "tonalSpot" }),
    }),
    {
      name: PALETTE_STORAGE_KEY,
      version: 1,
      partialize: ({ seed, variant }) => ({ seed, variant }),
      // Never trust localStorage: invalid data falls back to defaults
      merge: (persisted, current) => {
        const parsed = paletteSchema.safeParse(persisted);
        return parsed.success ? { ...current, ...parsed.data } : current;
      },
    },
  ),
);
</file>

<file path="src/stores/photoStore.ts">
import { create } from "zustand";

import { loadPhoto } from "@/lib/ticket/photo";
import type { Photo, PhotoSlot } from "@/lib/ticket/types";
import { useViewStore } from "@/stores/viewStore";

type PhotoState = {
  main: Photo | null;
  stub: Photo | null;
  error: string;
  add: (slot: PhotoSlot, file: File) => Promise<void>;
  patch: (slot: PhotoSlot, patch: Partial<Photo>) => void;
  clear: (slot: PhotoSlot) => void;
  swap: () => void;
  copyMainToStub: () => void;
  dismissError: () => void;
};

const only = (slot: PhotoSlot, photo: Photo | null): Partial<PhotoState> =>
  slot === "main" ? { main: photo } : { stub: photo };

// Decoded photos can't be saved to localStorage, so they live here and are gone on reload
export const usePhotoStore = create<PhotoState>()((set, get) => ({
  main: null,
  stub: null,
  error: "",
  add: async (slot, file) => {
    try {
      const hadMain = get().main !== null;
      set({ ...only(slot, await loadPhoto(file)), error: "" });
      // The first main photo "prints" the ticket
      if (slot === "main" && !hadMain) useViewStore.getState().reprint();
    } catch (e) {
      set({ error: e instanceof Error ? e.message : "That file could not be read." });
    }
  },
  patch: (slot, patch) => {
    const photo = get()[slot];
    if (photo) set(only(slot, { ...photo, ...patch }));
  },
  clear: (slot) => set(only(slot, null)),
  swap: () => set((s) => ({ main: s.stub, stub: s.main })),
  copyMainToStub: () => {
    const { main } = get();
    if (main) set({ stub: { ...main, id: crypto.randomUUID(), x: 0, y: 0, z: 1.6 } });
  },
  dismissError: () => set({ error: "" }),
}));
</file>

<file path="src/stores/ticketerStore.ts">
import { create } from "zustand";
import { persist } from "zustand/middleware";

import type { FieldKey } from "@/lib/ticket/fields";
import {
  settingsSchema,
  type Adjust,
  type MainShape,
  type Settings,
  type StubArea,
} from "@/lib/ticket/settings";

type TicketerState = {
  settings: Settings;
  update: (patch: Partial<Settings>) => void;
  updateStubArea: (patch: Partial<StubArea>) => void;
  updateMainShape: (patch: Partial<MainShape>) => void;
  updateAdjust: (patch: Partial<Adjust>) => void;
  setField: (key: FieldKey, value: string) => void;
  setShow: (key: string, value: boolean) => void;
  setFields: (patch: Partial<Record<FieldKey, string>>) => void;
  reset: () => void;
};

export const TICKETER_STORAGE_KEY = "ticketer-settings";

const defaults = () => settingsSchema.parse({});

export const useTicketerStore = create<TicketerState>()(
  persist(
    (set) => ({
      settings: defaults(),
      update: (patch) => set((s) => ({ settings: { ...s.settings, ...patch } })),
      updateStubArea: (patch) =>
        set((s) => ({
          settings: { ...s.settings, stubArea: { ...s.settings.stubArea, ...patch } },
        })),
      updateMainShape: (patch) =>
        set((s) => ({
          settings: { ...s.settings, mainShape: { ...s.settings.mainShape, ...patch } },
        })),
      updateAdjust: (patch) =>
        set((s) => ({ settings: { ...s.settings, adjust: { ...s.settings.adjust, ...patch } } })),
      setField: (key, value) =>
        set((s) => ({
          settings: { ...s.settings, fields: { ...s.settings.fields, [key]: value } },
        })),
      setFields: (patch) =>
        set((s) => ({ settings: { ...s.settings, fields: { ...s.settings.fields, ...patch } } })),
      setShow: (key, value) =>
        set((s) => ({ settings: { ...s.settings, show: { ...s.settings.show, [key]: value } } })),
      reset: () => set({ settings: defaults() }),
    }),
    {
      name: TICKETER_STORAGE_KEY,
      version: 1,
      partialize: ({ settings }) => ({ settings }),
      // Never trust localStorage: invalid data falls back to defaults
      merge: (persisted, current) => {
        const parsed = settingsSchema.safeParse(
          (persisted as { settings?: unknown } | undefined)?.settings,
        );
        return parsed.success ? { ...current, settings: parsed.data } : current;
      },
    },
  ),
);
</file>

