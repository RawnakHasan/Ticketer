  stampAt,
  tearLine,
  ticketKit,
} from "./shared";
import type { Rendered, TicketState } from "./types";

// Full-bleed photo with the title over it, and a tear-off stub on the right
export function renderConcert(S: TicketState, k: number): Rendered {
